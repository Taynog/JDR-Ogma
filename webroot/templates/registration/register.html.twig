{% extends '@App/base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
    <div class="auth-card">
        <h1 class="auth-card__title">Créer un compte</h1>
        <p class="auth-card__subtitle">Rejoignez la communauté Ogma</p>

        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="auth-alert auth-alert--danger" role="alert">{{ flash_error }}</div>
        {% endfor %}

        {{ form_start(registrationForm, { attr: { class: 'auth-form' } }) }}
            {% if registrationForm.vars.errors|length %}
                <div class="auth-alert auth-alert--danger">{{ form_errors(registrationForm) }}</div>
            {% endif %}

            {{ form_row(registrationForm.email, { row_attr: { class: 'auth-field' } }) }}
            {{ form_row(registrationForm.username, { row_attr: { class: 'auth-field' } }) }}
            {{ form_row(registrationForm.plainPassword, { row_attr: { class: 'auth-field' } }) }}
            {{ form_row(registrationForm.agreeTerms, { row_attr: { class: 'auth-field auth-field--checkbox' } }) }}

            <button type="submit" class="auth-btn">Créer mon compte</button>
        {{ form_end(registrationForm) }}

        <p class="auth-card__switch">
            Vous avez déjà un compte ?
            <a href="{{ path('app_login') }}">Connectez-vous</a>.
        </p>
    </div>
{% endblock %}