{% extends '@App/base.html.twig' %}
{% block title %}
    {{ 'combat_art.title'|trans }}
{% endblock %}
{% block body %}
<h1 id="manoeuvres_combat" onclick="hideContent(this)">{{ 'combat_art.maneuvers.title'|trans }}</h1>
<div>
    <p>{{ 'combat_art.maneuvers.intro1'|trans }}</p>
    <p>{{ 'combat_art.maneuvers.intro2'|trans }}</p>
    <p>{{ 'combat_art.maneuvers.intro3'|trans }}</p>
    <p id="arts_du_combat_basiques" class="caption" onclick="hideContent(this)">{{ 'combat_art.basics.title'|trans }}</p>
    <div>
        <p>{{ 'combat_art.basics.description'|trans }}</p>
        <table>
            <thead>
            <tr>
                <th>{{ 'combat_art.column.name'|trans }}</th>
                <th>{{ 'combat_art.column.description'|trans }}</th>
                <th>{{ 'combat_art.column.conditions'|trans }}</th>
                <th>{{ 'combat_art.column.player_test'|trans }}</th>
                <th>{{ 'combat_art.column.enemy_test'|trans }}</th>
                <th>{{ 'combat_art.column.effect'|trans }}</th>
                <th>{{ 'combat_art.column.critique'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for art in basics %}
            <tr>
                <th>{{ art.name }}</th>
                <td>{{ art.description|raw }}</td>
                <td>{{ art.conditions ? art.conditions|raw : '-' }}</td>
                <td>{{ art.assaillantTest|raw }}</td>
                <td>{{ art.defenderTest ? art.defenderTest|raw : '-' }}</td>
                <td>{{ art.effect|raw }}</td>
                <td>{{ art.critique ? art.critique|raw : 'R: /<br/>E: /' }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <p id="arts_du_combat_specialistes" class="caption" onclick="hideContent(this)">{{ 'combat_art.specialist.title'|trans }}</p>
    <div>
        <p>{{ 'combat_art.specialist.description'|trans }}</p>
        <table>
            <thead>
            <tr>
                <th>{{ 'combat_art.column.skill'|trans }}</th>
                <th>{{ 'combat_art.column.tier'|trans }}</th>
                <th>{{ 'combat_art.column.name'|trans }}</th>
                <th>{{ 'combat_art.column.description'|trans }}</th>
                <th>{{ 'combat_art.column.conditions'|trans }}</th>
                <th>{{ 'combat_art.column.player_test'|trans }}</th>
                <th>{{ 'combat_art.column.enemy_test'|trans }}</th>
                <th>{{ 'combat_art.column.effect'|trans }}</th>
                <th>{{ 'combat_art.column.critique'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for category, tiers in specialist %}
                {% set cat_total = 0 %}
                {% for tier, arts in tiers %}
                    {% set cat_total = cat_total + arts|length + 1 %}
                {% endfor %}
                {% set cat_done = false %}
                {% for tier, arts in tiers %}
                    {% if not cat_done %}
                <tr>
                    <th rowspan="{{ cat_total }}">{{ category }}</th>
                    <th rowspan="{{ arts|length + 1 }}">{{ tier }}</th>
                    {% set cat_done = true %}
                    {% else %}
                <tr>
                    <th rowspan="{{ arts|length + 1 }}">{{ tier }}</th>
                    {% endif %}
                    {% for art in arts %}
                    {% if not loop.first %}
                <tr>
                    {% endif %}
                        <th>{{ art.name }}</th>
                        <td>{{ art.description|raw }}</td>
                        <td>{{ art.conditions ? art.conditions|raw : '-' }}</td>
                        <td>{{ art.assaillantTest|raw }}</td>
                        <td>{{ art.defenderTest ? art.defenderTest|raw : '-' }}</td>
                        <td>{{ art.effect|raw }}</td>
                        <td>{{ art.critique ? art.critique|raw : 'R: /<br/>E: /' }}</td>
                    </tr>
                    {% endfor %}
                {% endfor %}
            {% endfor %}
            </tbody>
        </table>
    </div>
    <p id="arts_du_combat" class="caption" onclick="hideContent(this)">{{ 'combat_art.arts.title'|trans }}</p>
    <div>
        <p>{{ 'combat_art.arts.description'|trans }}</p>
        <table>
            <thead>
            <tr>
                <th>{{ 'combat_art.column.skill'|trans }}</th>
                <th>{{ 'combat_art.column.tier'|trans }}</th>
                <th>{{ 'combat_art.column.name'|trans }}</th>
                <th>{{ 'combat_art.column.description'|trans }}</th>
                <th>{{ 'combat_art.column.conditions'|trans }}</th>
                <th>{{ 'combat_art.column.player_test'|trans }}</th>
                <th>{{ 'combat_art.column.enemy_test'|trans }}</th>
                <th>{{ 'combat_art.column.effect'|trans }}</th>
                <th>{{ 'combat_art.column.critique'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for category, tiers in arts %}
                {% set cat_total = 0 %}
                {% for tier, art_list in tiers %}
                    {% set cat_total = cat_total + art_list|length + 1 %}
                {% endfor %}
                {% set cat_done = false %}
                {% for tier, art_list in tiers %}
                    {% if not cat_done %}
                <tr>
                    <th rowspan="{{ cat_total }}">{{ category }}</th>
                    <th rowspan="{{ art_list|length + 1 }}">{{ tier }}</th>
                    {% set cat_done = true %}
                    {% else %}
                <tr>
                    <th rowspan="{{ art_list|length + 1 }}">{{ tier }}</th>
                    {% endif %}
                    {% for art in art_list %}
                    {% if not loop.first %}
                <tr>
                    {% endif %}
                        <th>{{ art.name }}</th>
                        <td>{{ art.description|raw }}</td>
                        <td>{{ art.conditions ? art.conditions|raw : '-' }}</td>
                        <td>{{ art.assaillantTest|raw }}</td>
                        <td>{{ art.defenderTest ? art.defenderTest|raw : '-' }}</td>
                        <td>{{ art.effect|raw }}</td>
                        <td>{{ art.critique ? art.critique|raw : 'R: /<br/>E: /' }}</td>
                    </tr>
                    {% endfor %}
                {% endfor %}
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
