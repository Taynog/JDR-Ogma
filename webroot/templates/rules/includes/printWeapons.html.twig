{% set cat = weapons|first %}
{% if cat %}
    <p id="{{ 'table_weapon_melee_' ~ category|lower }}" class="caption">{{ cat.category.category }}</p>
    {% if cat.category.description %}
        <p id="{{ 'table_weapon_melee_' ~ category|lower ~ '_description' }}">{{ cat.category.description }}</p>
    {% endif %}
    {% if cat.category.effect %}
        <p id="{{ 'table_weapon_melee_' ~ category|lower ~ '_effect' }}">{{ cat.category.effect }}</p>
    {% endif %}
{% endif %}

<table>
    <tbody>
    <tr>
        <th>{{ 'weapon.type'|trans }}</th>
        <th>{{ 'weapon.damage_type'|trans }}</th>
        <th>{{ 'weapon.damage'|trans }}</th>
        <th>{{ 'weapon.handling'|trans }}</th>
        <th>{{ 'weapon.reach'|trans }}</th>
        <th>{{ 'weapon.properties'|trans }}</th>
        <th>{{ 'weapon.enc'|trans }}</th>
        <th>{{ 'weapon.price'|trans }}</th>
    </tr>
    {% for weapon in weapons %}
        <tr>
            <td id="{{ 'weapon_' ~ weapon.type|lower }}"> {{ weapon.type }} </td>
            <td> {{ weapon.damageType }} </td>
            <td> {{ weapon.damage }} </td>
            <td> {{ weapon.handling }} </td>
            <td> {{ weapon.reach }} </td>
            <td>
                {% include '@App/rules/includes/printWeaponProperties.html.twig' with {'properties' : weapon.weaponProperties} %}
            </td>
            <td> {{ weapon.enc }} </td>
            <td> {{ weapon.price }} </td>
        </tr>
    {% endfor %}
    </tbody>
</table>