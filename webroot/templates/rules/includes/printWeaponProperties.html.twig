{% for property in properties %}
    property.property
    {% if property.weaponPropertyDetails.x is not null %}
        ({{ property.weaponPropertyDetails.x }}
        {% if property.weaponPropertyDetails.y is not null %}
            , {{ property.weaponPropertyDetails.y }}
            {% if property.weaponPropertyDetails.z is not null %}
                , {{ property.weaponPropertyDetails.z }}
            {% endif %}
        {% endif %}
        )
    {% endif %}
{% endfor %}