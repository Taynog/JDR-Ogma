{% extends '@App/base.html.twig' %}
{% block title %}
    Glossaire
{% endblock %}
{% block body %}
    <h1 id="etats" onclick="hideContent(this)">États</h1>
    <div>
        <p>Si plus d'un état affecte le personnage, appliquez-en tous les effets. Si les effets ne peuvent se combiner, appliquez les plus handicapants.</p>
        {% for c in conditions %}
            <h3 id="{{ c.condition|slug }}" onclick="hideContent(this)">{{ c.condition }}</h3>
            <div>
                {{ c.description|raw }}
            </div>
        {% endfor %}
    </div>

    <h1 id="traits" onclick="hideContent(this)">Traits</h1>
    <div>
        {% for t in traits %}
            <h3 id="{{ t.trait|slug }}" onclick="hideContent(this)">{{ t.trait }}</h3>
            <div>
                {{ t.description|raw }}
            </div>
        {% endfor %}
    </div>
{% endblock %}
