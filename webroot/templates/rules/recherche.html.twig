{% extends '@App/base.html.twig' %}
{% import '@App/macros/sort.html.twig' as sortMacro %}
{% block title %}
    Résultat de recherche
{% endblock %}
{% block body %}
    <h1>Résultat de recherche</h1>

    <div id="effets_results">
        {% for sort in results %}
            {{ sortMacro.printSort(sort, true) }}
        {% else %}
            <p><em>Aucun résultat trouvé.</em></p>
        {% endfor %}
    </div>
{% endblock %}
